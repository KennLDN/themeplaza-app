; 2D renderer vertex shader: position, texture coordinate, colour.

.fvec projection[4]

.constf consts(1.0, 0.0, 0.00392156862, 0.0)   ; 1, 0, 1/255

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias intc  v1
.alias inclr v2

.proc main
	mov r0.xyz, inpos
	mov r0.w,   consts.xxxx

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intc

	; colour arrives as bytes 0..255
	mul outclr, consts.zzzz, inclr

	end
.end
